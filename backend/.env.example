# --- Server ---
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API.
# Example: http://localhost:5173,https://www.my-domain.com
CORS_ORIGIN=http://localhost:5173

# --- Database (Supabase / PostgreSQL) ---
# Use the "Connection string" (URI) from Supabase Project Settings → Database.
# Include ?sslmode=require for hosted Postgres.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Email (Resend) ---
RESEND_API_KEY=
# The address submissions are sent TO.
ADMIN_EMAIL=maruthienterprises00777@gmail.com
# The address emails are sent FROM. Must be on a domain you've verified in Resend.
FROM_EMAIL=notifications@my-domain.com

# --- Auth ---
# Long, random string used to sign admin session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cookie name for the admin session token (rarely needs changing).
SESSION_COOKIE_NAME=mc_admin_session
